meta {
  name: Downloads a previously uploaded attachment file
  type: http
  seq: 3
  tags: [
    Attachments
  ]
}

get {
  url: {{baseUrl}}/api/v1/attachments/download
  body: none
  auth: apikey
}

params:query {
  ~FileName: 
  ~FilePlace: 
  ~MediaType: 0
  ~MediaType: 1
  ~MediaType: 2
  ~MediaType: 3
}

headers {
  @description('Preferred language for the response. Supported values: `ar`, `en`.')
  Accept-Language: ar
  @description("Enter the word 'Bearer' followed by a space and your JWT. Example: Bearer eyJhbGciOiJIUzI1NiIs...")
  Authorization: {{apiKey}}
  @description('Preferred language for the response. Supported values: `ar`, `en`.')
  ~Accept-Language: en
}

auth:apikey {
  key: Authorization
  value: {{apiKey}}
  placement: header
}

example {
  name: 200 Response
  description: File content.
  
  request: {
    url: {{baseUrl}}/api/v1/attachments/download
    method: GET
    mode: none
    params:query: {
      ~FileName: 
      ~FilePlace: 
      ~MediaType: 0
      ~MediaType: 1
      ~MediaType: 2
      ~MediaType: 3
    }
  
    headers: {
      Accept-Language: ar
      ~Accept-Language: en
      Authorization: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized — missing, malformed, expired or revoked access token. Log in (or refresh) to obtain a new one.
  
  request: {
    url: {{baseUrl}}/api/v1/attachments/download
    method: GET
    mode: none
    params:query: {
      ~FileName: 
      ~FilePlace: 
      ~MediaType: 0
      ~MediaType: 1
      ~MediaType: 2
      ~MediaType: 3
    }
  
    headers: {
      Accept-Language: ar
      ~Accept-Language: en
      Authorization: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 403 Response
  description: Forbidden — valid token, but the account lacks the required role/permission or is deactivated.
  
  request: {
    url: {{baseUrl}}/api/v1/attachments/download
    method: GET
    mode: none
    params:query: {
      ~FileName: 
      ~FilePlace: 
      ~MediaType: 0
      ~MediaType: 1
      ~MediaType: 2
      ~MediaType: 3
    }
  
    headers: {
      Accept-Language: ar
      ~Accept-Language: en
      Authorization: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: Not found
  
  request: {
    url: {{baseUrl}}/api/v1/attachments/download
    method: GET
    mode: none
    params:query: {
      ~FileName: 
      ~FilePlace: 
      ~MediaType: 0
      ~MediaType: 1
      ~MediaType: 2
      ~MediaType: 3
    }
  
    headers: {
      Accept-Language: ar
      ~Accept-Language: en
      Authorization: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "isSuccess": false,
          "errors": {
            "General": [
              "The requested resource was not found."
            ]
          },
          "data": null,
          "message": "The requested resource was not found.",
          "statusCode": 404
        }
      '''
    }
  }
}
