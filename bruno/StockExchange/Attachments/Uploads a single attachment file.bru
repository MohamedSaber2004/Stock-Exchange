meta {
  name: Uploads a single attachment file
  type: http
  seq: 1
  tags: [
    Attachments
  ]
}

post {
  url: {{baseUrl}}/api/v1/attachments/upload
  body: multipartForm
  auth: apikey
}

headers {
  @description('Preferred language for the response. Supported values: `ar`, `en`.')
  Accept-Language: ar
  @description("Enter the word 'Bearer' followed by a space and your JWT. Example: Bearer eyJhbGciOiJIUzI1NiIs...")
  Authorization: {{apiKey}}
  @description('Preferred language for the response. Supported values: `ar`, `en`.')
  ~Accept-Language: en
}

auth:apikey {
  key: Authorization
  value: {{apiKey}}
  placement: header
}

body:multipart-form {
  File: @file()
  MediaType: 
  Place: 
}

example {
  name: Success
  
  request: {
    url: {{baseUrl}}/api/v1/attachments/upload
    method: POST
    mode: multipartForm
    headers: {
      Accept-Language: ar
      ~Accept-Language: en
      Authorization: {{apiKey}}
    }
  
    body:multipart-form: {
      File: @file()
      MediaType: 
      Place: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "isSuccess": true,
          "errors": {},
          "data": "string",
          "message": "Resource created successfully.",
          "statusCode": 201
        }
      '''
    }
  }
}

