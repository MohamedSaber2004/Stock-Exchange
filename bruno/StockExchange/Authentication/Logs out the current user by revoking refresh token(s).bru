example {
  name: Missing or malformed token
  
  request: {
    url: {{baseUrl}}/api/v1/authentication/logout
    method: POST
    mode: json
    headers: {
      Accept-Language: ar
      ~Accept-Language: en
      Authorization: {{apiKey}}
    }
  
    body:json: {
      {
        "refreshToken": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "isSuccess": false,
          "errors": {
            "General": [
              "You are not authorized to perform this action."
            ]
          },
          "data": null,
          "message": "You are not authorized to perform this action.",
          "statusCode": 401
        }
      '''
    }
  }
}

example {
  name: Expired session — log in (or refresh) again
  description: The access token expired, was killed by logout/refresh rotation, or belongs to a deactivated account. Obtain a new token via login or refresh-token.
  
  request: {
    url: {{baseUrl}}/api/v1/authentication/logout
    method: POST
    mode: json
    headers: {
      Accept-Language: ar
      ~Accept-Language: en
      Authorization: {{apiKey}}
    }
  
    body:json: {
      {
        "refreshToken": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "isSuccess": false,
          "errors": {
            "General": [
              "You are not authorized to perform this action."
            ]
          },
          "data": null,
          "message": "You are not authorized to perform this action.",
          "statusCode": 401
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Forbidden — valid token, but the account lacks the required role/permission or is deactivated.
  
  request: {
    url: {{baseUrl}}/api/v1/authentication/logout
    method: POST
    mode: json
    headers: {
      Accept-Language: ar
      ~Accept-Language: en
      Authorization: {{apiKey}}
    }
  
    body:json: {
      {
        "refreshToken": ""
      }
    }
  }
  
  response: {
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

