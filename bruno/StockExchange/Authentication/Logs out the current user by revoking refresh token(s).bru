    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "isSuccess": false,
          "errors": {
            "email": [
              "Invalid email address format."
            ]
          },
          "data": null,
          "message": "One or more validation errors occurred.",
          "statusCode": 400
        }
      '''
    }
  }
}

