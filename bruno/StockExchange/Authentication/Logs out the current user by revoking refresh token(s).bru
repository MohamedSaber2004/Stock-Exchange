meta {
  name: Logs out the current user by revoking refresh token(s)
  type: http
  seq: 6
  tags: [
    Authentication
  ]
}

post {
  url: {{baseUrl}}/api/v1/authentication/logout
  body: json
  auth: apikey
}

headers {
  @description('Preferred language for the response. Supported values: `ar`, `en`.')
  Accept-Language: ar
  @description("Enter the word 'Bearer' followed by a space and your JWT. Example: Bearer eyJhbGciOiJIUzI1NiIs...")
  Authorization: {{apiKey}}
  @description('Preferred language for the response. Supported values: `ar`, `en`.')
  ~Accept-Language: en
}

auth:apikey {
  key: Authorization
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "refreshToken": ""
  }
}

example {
  name: Success
  
  request: {
    url: {{baseUrl}}/api/v1/authentication/logout
    method: POST
    mode: json
    headers: {
      Accept-Language: ar
      ~Accept-Language: en
      Authorization: {{apiKey}}
    }
  
    body:json: {
      {
        "refreshToken": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "isSuccess": true,
          "errors": {},
          "data": true,
          "message": "Operation completed successfully.",
          "statusCode": 200
        }
      '''
    }
  }
}

