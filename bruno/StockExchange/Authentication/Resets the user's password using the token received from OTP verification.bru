meta {
  name: Resets the user's password using the token received from OTP verification
  type: http
  seq: 4
  tags: [
    Authentication
  ]
}

post {
  url: {{baseUrl}}/api/v1/authentication/reset-password
  body: json
  auth: inherit
}

headers {
  @description('Preferred language for the response. Supported values: `ar`, `en`.')
  Accept-Language: ar
  @description('Preferred language for the response. Supported values: `ar`, `en`.')
  ~Accept-Language: en
}

body:json {
  {
    "email": "",
    "otpCode": "",
    "newPassword": "",
    "confirmPassword": ""
  }
}

example {
  name: Success
  
  request: {
    url: {{baseUrl}}/api/v1/authentication/reset-password
    method: POST
    mode: json
    headers: {
      Accept-Language: ar
      ~Accept-Language: en
    }
  
    body:json: {
      {
        "email": "",
        "otpCode": "",
        "newPassword": "",
        "confirmPassword": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "isSuccess": true,
          "errors": {},
          "data": true,
          "message": "Operation completed successfully.",
          "statusCode": 200
        }
      '''
    }
  }
}

