meta {
  name: Authenticates a user with a Google ID token, provisioning the account on first sign-in, and returns JWT access and refresh tokens
  type: http
  seq: 1
  tags: [
    Authentication
  ]
}

post {
  url: {{baseUrl}}/api/v1/authentication/login-with-google
  body: json
  auth: inherit
}

headers {
  @description('Preferred language for the response. Supported values: `ar`, `en`.')
  Accept-Language: ar
  @description('Preferred language for the response. Supported values: `ar`, `en`.')
  ~Accept-Language: en
}

body:json {
  {
    "idToken": ""
  }
}

example {
  name: Success
  
  request: {
    url: {{baseUrl}}/api/v1/authentication/login-with-google
    method: POST
    mode: json
    headers: {
      Accept-Language: ar
      ~Accept-Language: en
    }
  
    body:json: {
      {
        "idToken": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "isSuccess": true,
          "errors": {},
          "data": {
            "accessToken": "string",
            "refreshToken": "string",
            "fullName": "string",
            "email": "string",
            "phoneNumber": "string",
            "roles": "string",
            "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
            "profilePictureUrl": "string"
          },
          "message": "Operation completed successfully.",
          "statusCode": 200
        }
      '''
    }
  }
}

